{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caspian Register",
  "version": "0.1.0",
  "identifier": "app.caspian.register",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Caspian Tools",
    "category": "Business",
    "shortDescription": "The in-person register",
    "longDescription": "Opens your shop's point-of-sale register in its own window, with the store address already set so a cashier never types one.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
