# Claude Code local state. Ignore everything under .claude/ EXCEPT a committed
# settings.json, so shared worktree/session config can be tracked while the
# isolated worktrees (.claude/worktrees/, parallel sessions) never surface as
# untracked files in the main checkout.
.claude/*
!.claude/settings.json
.claude/worktrees/
.vscode/
package-lock.json
examples/**/next-env.d.ts
*.tgz
.DS_Store
*.log
.env
.env.local
.env.*.local
service-account.json
serviceAccountKey*.json
credentials.json
.turbo/
.next/
.vite/
.cache/
coverage/
*.tsbuildinfo
